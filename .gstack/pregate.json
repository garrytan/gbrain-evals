{
  "$schema": "https://github.com/garrytan/gstack/docs/pregate.md#pregate-v1",
  "timeout_s": 1800,
  "sealed": {
    "paths": ["**/rs1-custody*", "**/rs1-custody*/**", "**/*.rs1-seed"],
    "case_insensitive": true,
    "answer_markers": ["RS1-SEALED-CUSTODY-v[0-9]+"],
    "seed_patterns": ["rs1-seed-v1:[0-9a-f]{64}"]
  },
  "run_profiles": {
    "ci-carry/tests": { "workflow": "ci.yml", "events": ["pull_request", "push"], "jobs": ["checks", "tests (1)", "tests (2)", "tests (3)", "tests (4)", "tested-tree"], "artifact": "tested-tree", "os": "Linux" }
  },
  "ship_lanes_from": {
    "bun run test": { "profiles": ["ci-carry/tests"], "inventory": "bun --no-env-file --config=/dev/null scripts/ci-tested-tree.ts inventory --lane test" },
    "TEST_SHARDS=1 bun run test": { "profiles": ["ci-carry/tests"], "inventory": "bun --no-env-file --config=/dev/null scripts/ci-tested-tree.ts inventory --lane test" },
    "TEST_SHARDS=2 bun run test": { "profiles": ["ci-carry/tests"], "inventory": "bun --no-env-file --config=/dev/null scripts/ci-tested-tree.ts inventory --lane test" },
    "bun run test:unit": { "profiles": ["ci-carry/tests"], "inventory": "bun --no-env-file --config=/dev/null scripts/ci-tested-tree.ts inventory --lane unit" },
    "bun run test:py": { "profiles": ["ci-carry/tests"], "inventory": "bun --no-env-file --config=/dev/null scripts/ci-tested-tree.ts inventory --lane py" }
  }
}
