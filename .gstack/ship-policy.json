{
  "min_gstack_version": "1.97.0.0",
  "bump": "patch",
  "queue_mode": "stamp-at-merge",
  "changelog_fragments": {
    "dir": "changelog.d",
    "required_checks": [
      "checks",
      "prereg-order",
      "tested-tree",
      "scoreboard",
      "receipt-secrets"
    ]
  },
  "merge": "direct",
  "land": {
    "merged_checks": [
      "bun run validate",
      "bun eval/runner/prereg.ts"
    ]
  },
  "review_exclude_paths": [
