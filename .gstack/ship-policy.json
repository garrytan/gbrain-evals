{
  "min_gstack_version": "1.96.0.0",
  "bump": "patch",
  "queue_mode": "stamp-at-merge",
  "changelog_fragments": {
    "dir": "changelog.d",
    "required_checks": [
      "checks",
      "prereg-order",
      "tested-tree",
      "scoreboard",
      "receipt-secrets"
    ]
  },
  "merge": "direct",
  "land": {
    "merged_checks": [
      "bun run validate",
      "bun eval/runner/prereg.ts"
    ]
  },
  "review_exclude_paths": [
    "eval/data/skillopt-method-v3/briefing/**",
    "eval/data/skillopt-method-v3/fact-check/**",
    "eval/data/skillopt-method-v3/query/**",
    "eval/data/skillopt-method-v3/seeds/**",
    "eval/data/skillopt-method-v3/world/**",
    "docs/benchmarks/predictive-measures/**/scorecard.json",
    "docs/benchmarks/predictive-measures/**/episodes.jsonl.gz",
    "eval/data/changing-facts-v1/dev/worlds/*/world.json"
  ]
}
