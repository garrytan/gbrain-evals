    "eval/data/changing-facts-v1/fixtures/worlds/bg1-dev-20/questions.json",
    "docs/benchmarks/2026-11-16-w0-keyless-repin/counted/**",
    "docs/benchmarks/2026-11-17-readme-baselines/**/*.json",
    "docs/benchmarks/2026-11-17-readme-baselines/**/*.ndjson",
