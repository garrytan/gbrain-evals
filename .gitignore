# Dependencies
node_modules/
bun.lockb

# Secrets
.env
.env.*
!.env.example

# Build
dist/
bin/

# Opus cache (regenerate via eval:generate-amara-life; 398 items ~1.6MB)
eval/data/amara-life-v1/_cache/

# Opus cache (regenerate via eval:generate-transcript-distill; 24 transcripts)
eval/data/transcript-distill-v1/_cache/

# Benchmark run reports (transient — commit baselines to docs/benchmarks/ instead)
eval/reports/

# NOTE: eval/data/multimodal/ fixtures are COMMITTED (hermetic, sha256-pinned
# in each fixtures.json — audit retrieval-cats-03). A legacy ignore rule here
# referenced a fetch script that never existed and silently kept the fixtures
# out of git, so CI's fresh clone had none while local runs passed.

