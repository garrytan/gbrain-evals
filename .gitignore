# Dependencies
node_modules/
bun.lockb
bun.lock

# Secrets
.env
.env.*
!.env.example

# Build
dist/
bin/

# Opus cache (regenerate via eval:generate-amara-life; 398 items ~1.6MB)
eval/data/amara-life-v1/_cache/

# Benchmark run reports (transient — commit baselines to docs/benchmarks/ instead)
eval/reports/

# Multi-modal fixtures: binary sources are hash-verified via eval:fetch-multimodal
# and gitignored (regeneratable from the manifest). Manifests, READMEs, and the
# canonical golden text files are committed — canonicals are deterministic
# references small enough to ship in git, and pinning them avoids drift when
# upstream sources change. Negation rules are file-pattern-based (not
# whole-dir) because git can't re-include files inside an ignored directory.
eval/data/multimodal/*/*.pdf
eval/data/multimodal/*/*.html
eval/data/multimodal/*/*.mp3
eval/data/multimodal/*/*.ogg
eval/data/multimodal/*/*.wav
eval/data/multimodal/*/*.flac
eval/data/multimodal/*/*.m4a

# System files
.DS_Store
*.log
