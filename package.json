{
  "name": "gbrain-evals",
  "version": "0.10.22",
  "description": "BrainBench \u2014 public benchmark for personal knowledge agent stacks. Consumes gbrain as a library.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garrytan/gbrain-evals.git"
  },
  "scripts": {
    "test": "bun scripts/test-shards.ts && bun run test:py && bun run validate",
    "test:unit": "bun scripts/test-shards.ts",
    "test:serial": "bun test test/eval/ eval/",
    "test:py": "python3 test/retrieval_refresh_orchestrator_test.py",
    "validate": "python3 scripts/verify-published-longmemeval.py && python3 scripts/verify-longmemeval-opaque-qa.py >/dev/null && python3 scripts/verify-longmemeval-opaque-followups.py >/dev/null && python3 scripts/verify-documentation-refresh.py && python3 scripts/check-links.py && bun run eval:query:validate && bun eval/runner/validate-data.ts && bun scripts/check-comparator-name.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "eval:run": "bun eval/runner/multi-adapter.ts",
    "eval:run:dev": "BRAINBENCH_N=1 bun eval/runner/multi-adapter.ts",
    "eval:decide": "bun eval/runner/decide.ts",
    "eval:world:view": "bun eval/cli/world-view.ts",
    "eval:world:render": "bun eval/cli/world-view.ts --no-open",
    "eval:query:validate": "bun eval/cli/query-validate.ts",
    "eval:query:new": "bun eval/cli/query-new.ts",
    "eval:type-accuracy": "bun eval/runner/type-accuracy.ts",
    "eval:generate-amara-life": "bun eval/generators/amara-life-gen.ts",
    "eval:generate-amara-life:dry": "bun eval/generators/amara-life-gen.ts --dry-run",
    "eval:brainbench": "bun eval/runner/all.ts --tier offline",
    "eval:brainbench:paid": "bun eval/runner/all.ts --tier paid",
    "eval:brainbench:all": "bun eval/runner/all.ts --tier all",
    "eval:cat6": "bun eval/runner/cat6-prose-scale.ts",
    "eval:cat11": "bun eval/runner/cat11-multimodal.ts",
    "eval:cat35": "CAT35_FULL=1 bun eval/runner/cat35-transcript-distill.ts",
    "eval:cat35:smoke": "bun eval/runner/cat35-transcript-distill.ts",
    "eval:cat36": "bun eval/runner/cat36-associative-retrieval.ts --offline",
    "eval:cat36:smoke": "bun eval/runner/cat36-associative-retrieval.ts --offline --smoke",
    "eval:mpw:power": "bun eval/runner/memory-proof-wave-power.ts simulate",
    "eval:mpw:grouping": "bun eval/runner/memory-proof-wave-grouping.ts check",
    "eval:system-one": "bun eval/runner/system-one-jev.ts verify",
    "eval:system-one:plan": "bun eval/runner/system-one-jev.ts plan",
    "eval:generate-transcript-distill": "bun eval/generators/transcript-distill-gen.ts",
    "eval:generate-transcript-distill:dry": "bun eval/generators/transcript-distill-gen.ts --dry-run",
    "harness:setup": "bun eval/runner/harness-env.ts",
    "harness:test": "bun eval/runner/harness-test.ts",
    "harness:cell": "bun eval/runner/harness-cell.ts",
    "harness:comparator": "bun eval/runner/harness-comparator.ts",
    "eval:passing-details": "bun eval/workload-suites/cli.ts passing-details",
    "eval:passing-details:smoke": "bun eval/workload-suites/cli.ts passing-details --smoke",
    "eval:passing-details:dry": "bun eval/workload-suites/cli.ts passing-details --dry-run",
    "eval:corrections": "bun eval/workload-suites/cli.ts corrections",
    "eval:corrections:smoke": "bun eval/workload-suites/cli.ts corrections --smoke",
    "eval:corrections:dry": "bun eval/workload-suites/cli.ts corrections --dry-run",
    "eval:time-relationships": "bun eval/workload-suites/cli.ts time-relationships",
    "eval:time-relationships:smoke": "bun eval/workload-suites/cli.ts time-relationships --smoke",
    "eval:time-relationships:dry": "bun eval/workload-suites/cli.ts time-relationships --dry-run",
    "eval:beliefs": "bun eval/workload-suites/cli.ts beliefs",
    "eval:beliefs:smoke": "bun eval/workload-suites/cli.ts beliefs --smoke",
    "eval:beliefs:dry": "bun eval/workload-suites/cli.ts beliefs --dry-run",
    "eval:workload-suites": "bun eval/workload-suites/cli.ts all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "ai": "^6.0.168",
    "gbrain": "github:garrytan/gbrain#739e5cc89ca43b9b9351f0f203c7b12a7c0c571c",
    "gbrain-cues": "github:garrytan/gbrain#939232f1746381b4e932d620d6c709e29198f14c",
    "gbrain-reader": "github:garrytan/gbrain#e78f1c38b947b053f3a46881340f74f316be855a"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^3.12.10",
    "typescript": "5.9.3"
  },
  "keywords": [
    "gbrain",
    "brainbench",
    "benchmark",
    "personal-knowledge-agent",
    "retrieval-eval",
    "rag-benchmark"
  ],
  "patchedDependencies": {
    "postgres@3.4.9": "patches/postgres@3.4.9.patch"
  }
}
