{
 "schema": "nightly-item-support/1",
 "suite": "beam-1m-hard",
 "about": "Whether each beam-1m-hard item's reference answer is supported by the turns it cites, from the BEAM support check (eval/custody/rs1/validate.ts as of branch rs1-narrow-results at cf73d324, sha256 7805fa768dd94caae2166faf5bf17a202559c20150398ddac239295ce7ed576e, validators gemini-3.8-flash and claude-haiku-5-5, an empty public index). A gate support:<validator> means that validator found the answer unsupported; uncited, or cited 0, means the item cites no turn. An item counts as unsupported only when both validators reject it, or it cites no turn, and the every-gold-session arm (oracle) fails it too. Read by eval/runner/nightly/item-support.ts; kept out of the dev set so the suite digest is unchanged.",
 "validators": [
  "gemini:gemini-3.8-flash",
  "anthropic:claude-haiku-5-5"
 ],
