{
  "version": 1,
  "status": "draft: free checks only; the judged rubric is a placeholder that no judged run reads. Run with `bun eval/runner/cat9-workflows.ts --checks --scenarios eval/data/cat9-engine-coverage-v1/scenarios.json`",
  "about": "Free behavior scenarios for behavior the Rust engine had no end-to-end check for: deleting a private fact, a take or a private timeline entry leaves no text behind; purging a private page keeps pages derived from it private; a member listed as a reader can rewrite a page and an unlisted member cannot; the engine-swap refusal; a link to a page that does not exist yet; and sources unfederate. Every check is a gbrain CLI call with a fixed expectation, on a fresh keyword-only brain with no provider key. All names and text are invented.",
  "fixture": {
    "corpus_dir": "corpus",
    "free_run": "each scenario gets fresh keyword-only brains on the engine GBRAIN_EVAL_ENGINE names and its own copy of the corpus"
  },
  "scenarios": [
    {
      "id": "ec-01-private-fact-purged",
      "workflow": "email_to_brain",
      "origin": "Rust coverage hole: deleting a private fact leaves no text behind",
      "text": "Forget the private note about Olive Example's offer completely.",
      "ground_truth_slugs": [
        "people/olive-example"
      ],
      "rubric": [
        {
          "id": "gone",
          "criterion": "After the purge, nothing in the brain shows the offer's code name",
          "weight": 2
        }
      ],
      "setup": [
        {
          "run": [
            "put",
            "people/olive-example",
            "--json"
          ],
          "stdin": "puts/olive.md"
        },
        {
          "run": [
            "access",
            "member",
            "add",
            "bob-example",
            "--name",
            "Bob Example",
            "--json"
          ]
        },
        {
          "run": [
            "remember",
            "Olive Example is weighing a private offer code-named Kiwizebra from Orbit Labs",
            "--entity",
            "people/olive-example",
            "--provenance",
            "invented test note",
            "--visibility",
            "private",
            "--content-origin",
            "user_said",
            "--json"
          ],
          "capture": {
            "fact_id": "id"
          }
        }
      ],
      "checks": [
        {
          "id": "control-fact-on-page",
          "description": "Before the purge, the private fact's text is in the page's Facts block (so the later checks can see it leave).",
          "run": [
            "get",
            "people/olive-example"
          ],
          "expect": {
            "exit": "zero",
            "stdout_includes": [
              "Kiwizebra"
            ]
          },
          "depends_on": []
        },
        {
          "id": "control-fact-recalled",
          "description": "Before the purge, recall returns the private fact to the local owner.",
          "run": [
            "recall",
            "people/olive-example",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "facts[*].fact",
                "op": "some_match",
                "value": "Kiwizebra"
              }
            ]
          },
          "depends_on": []
        },
        {
          "id": "purge-removes-fact",
          "description": "gbrain forget --purge removes the fact row. Exit 10 (effects still queued) is allowed: a brain with no resident gbrain process cannot run them.",
          "run": [
            "forget",
            "{fact_id}",
            "--purge",
            "--yes",
            "--request-id",
            "6a0e1f2c-0000-4000-8000-000000000001",
            "--json"
          ],
          "expect": {
            "json": [
              {
                "path": "state",
                "op": "eq",
                "value": "committed"
              },
              {
                "path": "purge.removed.facts",
                "op": "eq",
                "value": 1
              }
            ]
          },
          "depends_on": []
        },
        {
          "id": "page-has-no-text",
          "description": "The page no longer shows the purged fact.",
          "run": [
            "get",
            "people/olive-example"
          ],
          "expect": {
            "exit": "zero",
            "stdout_includes": [
              "Olive Example runs finance"
            ],
            "stdout_excludes": [
              "Kiwizebra"
            ]
          },
          "depends_on": [
            "purge-removes-fact"
          ]
        },
        {
          "id": "member-view-has-no-text",
          "description": "A member's view of the public page has no text from the purged fact.",
          "run": [
            "get",
            "people/olive-example",
            "--as",
            "bob-example"
          ],
          "expect": {
            "exit": "zero",
            "stdout_includes": [
              "Olive Example runs finance"
            ],
            "stdout_excludes": [
              "Kiwizebra"
            ]
          },
          "depends_on": [
            "purge-removes-fact"
          ]
        },
        {
          "id": "recall-has-no-text",
          "description": "recall no longer returns the purged fact. (Keyword search does not index facts, so search cannot show it either way.)",
          "run": [
            "recall",
            "people/olive-example",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "stdout_excludes": [
              "Kiwizebra"
            ]
          },
          "depends_on": [
            "purge-removes-fact"
          ]
        }
      ]
    },
