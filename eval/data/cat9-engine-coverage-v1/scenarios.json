    {
      "id": "ec-05-listed-reader-rewrites-page",
      "workflow": "email_to_brain",
      "origin": "Rust coverage hole: a plain member can rewrite a page that lists them as a reader (gbrain test/access-writes.test.ts)",
      "text": "Tess wants to revise the launch plan she can read.",
      "ground_truth_slugs": [
        "notes/launch-plan"
      ],
      "rubric": [
        {
          "id": "rule",
          "criterion": "A listed reader's rewrite is saved and keeps the reader list; an unlisted member's rewrite is refused",
          "weight": 2
        }
      ],
      "setup": [
        {
          "run": [
            "access",
            "member",
            "add",
            "bob-example",
            "--name",
            "Bob Example",
            "--json"
          ]
        },
        {
          "run": [
            "access",
            "member",
            "add",
            "tess-example",
            "--name",
            "Tess Example",
            "--json"
          ]
        },
        {
          "run": [
            "put",
            "notes/launch-plan",
            "--json"
          ],
          "stdin": "puts/launch-plan.md",
          "capture": {
            "rev": "revision"
          }
        }
      ],
      "checks": [
        {
          "id": "unlisted-member-refused",
          "description": "A member the page does not list cannot rewrite it, and nothing changes.",
          "run": [
            "put",
            "notes/launch-plan",
            "--expected-revision",
            "{rev}",
            "--json"
          ],
          "expect": {
            "exit": "nonzero",
            "json": [
              {
                "path": "code",
                "op": "eq",
                "value": "enforced_member_refused"
              }
            ]
          },
          "stdin": "puts/launch-plan-by-bob.md",
          "member": "bob-example",
          "depends_on": []
        },
        {
          "id": "unchanged-after-refusal",
          "description": "The page still has its first text.",
          "run": [
            "get",
            "notes/launch-plan"
          ],
          "expect": {
            "exit": "zero",
            "stdout_includes": [
              "Tess Example drafts the launch plan."
            ],
            "stdout_excludes": [
              "Bob Example rewrote"
            ]
          },
          "depends_on": [
            "unlisted-member-refused"
          ]
        },
        {
          "id": "listed-reader-rewrites",
          "description": "A member the page lists as a reader rewrites it.",
          "run": [
            "put",
            "notes/launch-plan",
            "--expected-revision",
            "{rev}",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "slug",
                "op": "eq",
                "value": "notes/launch-plan"
              },
              {
                "path": "status",
                "op": "eq",
                "value": "created_or_updated"
              }
            ]
          },
          "stdin": "puts/launch-plan-by-tess.md",
          "member": "tess-example",
          "depends_on": []
        },
        {
          "id": "rewrite-saved-readers-kept",
          "description": "The rewrite is saved and the reader list is kept.",
          "run": [
            "get",
            "notes/launch-plan"
          ],
          "expect": {
            "exit": "zero",
            "stdout_includes": [
              "Revised by Tess Example",
              "tess-example"
            ]
          },
          "depends_on": [
            "listed-reader-rewrites"
          ]
        }
      ]
    },
    {
      "id": "ec-06-engine-swap-refusal",
      "workflow": "sync",
      "origin": "Rust coverage hole: the engine-swap refusal from gbrain pull request 10117",
      "text": "Can I move this brain to the Rust engine now?",
      "ground_truth_slugs": [],
      "rubric": [
        {
          "id": "refuses",
          "criterion": "Says the brain is not ready, names the reason, and changes nothing",
          "weight": 2
        }
      ],
      "engines": [
        "pglite",
        "postgres"
      ],
      "engines_note": "gbrain engine swap moves a PGLite or Postgres brain to the Rust engine; a brain already on Rust has nothing to swap.",
      "checks": [
        {
          "id": "managed-brain-refused",
          "description": "A brain on managed storage is refused with engine_swap_refused, reason managed_storage, before anything is read or written.",
          "run": [
            "engine",
            "swap",
            "--to",
            "rust",
            "--plan",
            "--json"
          ],
          "expect": {
            "exit": "nonzero",
            "json": [
              {
                "path": "code",
                "op": "eq",
                "value": "engine_swap_refused"
              },
              {
                "path": "reason",
                "op": "eq",
                "value": "managed_storage"
              }
            ]
          },
          "depends_on": []
        },
        {
          "id": "writer-status",
          "description": "The writer status names the admin state a deactivation must quote.",
          "run": [
            "sources",
            "writer",
            "status",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "enabled",
                "op": "eq",
                "value": true
              },
              {
                "path": "admin_state",
                "op": "exists"
              }
            ]
          },
          "capture": {
            "admin_state": "admin_state"
          },
          "depends_on": []
        },
        {
          "id": "turn-off-managed-storage",
          "description": "sources writer deactivate turns managed storage off.",
          "run": [
            "sources",
            "writer",
            "deactivate",
            "--admin-intent",
            "writer_deactivate",
            "--expected-state",
            "{admin_state}",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "deactivated",
                "op": "eq",
                "value": true
              },
              {
                "path": "mode",
                "op": "eq",
                "value": "classic"
              }
            ]
          },
          "depends_on": [
            "writer-status"
          ]
        },
        {
          "id": "no-shadow-not-ready",
          "description": "With no shadow, the plan says NOT READY with reason no_shadow.",
          "run": [
            "engine",
            "swap",
            "--to",
            "rust",
            "--plan",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "to",
                "op": "eq",
                "value": "rust"
              },
              {
                "path": "verdict",
                "op": "eq",
                "value": "NOT READY"
              },
              {
                "path": "reason",
                "op": "eq",
                "value": "no_shadow"
              }
            ]
          },
          "depends_on": [
            "turn-off-managed-storage"
          ]
        }
      ]
    },
    {
      "id": "ec-07-link-to-missing-page",
      "workflow": "email_to_brain",
      "origin": "Rust coverage gap 1: saving a page that links to a page that does not exist yet",
      "text": "Save a note that Pat Example works with someone who has no page yet.",
      "ground_truth_slugs": [
        "people/pat-example"
      ],
      "rubric": [
        {
          "id": "saved",
          "criterion": "The page is saved, the missing target is reported as wanted, and the link appears once the target exists",
          "weight": 2
        }
      ],
      "checks": [
        {
          "id": "put-saves-and-reports-wanted",
          "description": "put saves the page and lists the missing target as wanted.",
          "run": [
            "put",
            "people/pat-example",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "slug",
                "op": "eq",
                "value": "people/pat-example"
              },
              {
                "path": "auto_links.errors",
                "op": "eq",
                "value": 0
              },
              {
                "path": "auto_links.wanted[*].slug",
                "op": "includes",
                "value": "people/nobody-yet-example"
              }
            ]
          },
          "stdin": "puts/pat-links-missing.md",
          "depends_on": []
        },
        {
          "id": "page-readable",
          "description": "The saved page opens.",
          "run": [
            "get",
            "people/pat-example"
          ],
          "expect": {
            "exit": "zero",
            "stdout_includes": [
              "on the Widget Co budget"
            ]
          },
          "depends_on": [
            "put-saves-and-reports-wanted"
          ]
        },
        {
          "id": "wanted-lists-target",
          "description": "wanted lists the missing target and the page that links to it.",
          "run": [
            "wanted",
            "--source-id",
            "default",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "targets[*].target",
                "op": "includes",
                "value": "people/nobody-yet-example"
              }
            ]
          },
          "depends_on": [
            "put-saves-and-reports-wanted"
          ]
        },
        {
          "id": "create-target",
          "description": "Saving the target page works.",
          "run": [
            "put",
            "people/nobody-yet-example",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "slug",
                "op": "eq",
                "value": "people/nobody-yet-example"
              }
            ]
          },
          "stdin": "puts/nobody-yet.md",
          "depends_on": []
        },
        {
          "id": "extract-creates-edge",
          "description": "The next link extraction creates the edge.",
          "run": [
            "extract",
            "links",
            "--source",
            "db",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "links_created",
                "op": "gte",
                "value": 1
              }
            ]
          },
          "depends_on": [
            "put-saves-and-reports-wanted",
            "create-target"
          ]
        },
        {
          "id": "backlink-exists",
          "description": "The new page now has a backlink from the page that linked to it early.",
          "run": [
            "backlinks",
            "people/nobody-yet-example",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "[*].from_slug",
                "op": "includes",
                "value": "people/pat-example"
              }
            ]
          },
          "depends_on": [
            "extract-creates-edge"
          ]
        },
        {
          "id": "nothing-wanted",
          "description": "No link target is still wanted.",
          "run": [
            "wanted",
            "--source-id",
            "default",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "targets",
                "op": "empty"
              }
            ]
          },
          "depends_on": [
            "extract-creates-edge"
          ]
        }
      ]
    },
    {
      "id": "ec-08-sources-unfederate",
      "workflow": "sync",
      "origin": "Rust coverage gap 2: gbrain sources unfederate",
      "text": "Keep my work notes out of my default searches.",
      "ground_truth_slugs": [
        "projects/kumquat-protocol"
      ],
      "rubric": [
        {
          "id": "isolated",
          "criterion": "After unfederate, default search returns no work page; naming the work source still finds it",
          "weight": 2
        }
      ],
      "setup": [
        {
          "run": [
            "import",
            "{corpus}/default",
            "--no-embed",
            "--json"
          ]
        },
        {
          "run": [
            "sources",
            "add",
            "work",
            "--path",
            "{corpus}/work",
            "--json"
          ]
        },
        {
          "run": [
            "import",
            "{corpus}/work",
            "--source",
            "work",
            "--no-embed",
            "--json"
          ]
        }
      ],
      "checks": [
        {
          "id": "control-federated-search",
          "description": "Before unfederate, a default search finds the work page (a new source is federated).",
          "run": [
            "search",
            "Kumquat Protocol",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "[*].source_id",
                "op": "includes",
                "value": "work"
              }
            ]
          },
          "depends_on": []
        },
        {
          "id": "unfederate",
          "description": "sources unfederate work says the source is no longer federated.",
          "run": [
            "sources",
            "unfederate",
            "work",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "id",
                "op": "eq",
                "value": "work"
              },
              {
                "path": "federated",
                "op": "eq",
                "value": false
              }
            ]
          },
          "depends_on": []
        },
        {
          "id": "default-search-excludes-work",
          "description": "A default search returns no page from the work source.",
          "run": [
            "search",
            "Kumquat Protocol",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "[*].source_id",
                "op": "excludes",
                "value": "work"
              },
              {
                "path": "[*].slug",
                "op": "excludes",
                "value": "projects/kumquat-protocol"
              }
            ]
          },
          "depends_on": [
            "unfederate"
          ]
        },
        {
          "id": "named-search-finds-work",
          "description": "Naming the work source still finds the page.",
          "run": [
            "search",
            "Kumquat Protocol",
            "--source",
            "work",
            "--json"
          ],
          "expect": {
            "exit": "zero",
            "json": [
              {
                "path": "[*].slug",
                "op": "includes",
                "value": "projects/kumquat-protocol"
              }
            ]
          },
          "depends_on": []
        }
      ]
    }
  ]
}
