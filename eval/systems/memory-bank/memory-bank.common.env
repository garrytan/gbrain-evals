# SHIM_CONFIG=common: extraction LLM gpt-4.1-mini, embedder text-embedding-3-large at 1,536 dimensions. Reranker unchanged.
HINDSIGHT_API_LLM_MODEL=gpt-4.1-mini
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-large
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1536
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
