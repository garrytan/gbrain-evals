      ]
    }
  },
  {
    "name": "search",
    "description": "Cheap hybrid search (vector + keyword), no LLM expansion, top 20: for exact tokens, names, field values. Results are NOT proof of coverage: concepts or landscape, use `query`; exhaustive lists, list_pages. return_unit returns whole sections or conversations. Personal questions: get_recent_salience; saved facts: recall. fields: \"full\" adds diagnostics.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Exact tokens or names, e.g. 'acme-example series A'."
        },
        "limit": {
          "type": "number",
          "description": "Max results (default 20)."
        },
        "offset": {
          "type": "number",
          "description": "Rows to skip."
        },
        "mode": {
          "type": "string",
          "description": "Local callers only."
        },
        "source_id": {
          "type": "string",
          "description": "One source, or '__all__'."
        },
        "types": {
          "type": "array",
          "description": "Page types, e.g. ['person'].",
          "items": {
            "type": "string"
          }
        },
        "snippet_chars": {
          "type": "number",
          "description": "Max chars per chunk_text (0 = full)."
        },
        "return_unit": {
          "type": "string",
          "description": "chunk, window, section, page or auto (default; whole page for conversations).",
          "enum": [
            "chunk",
            "window",
            "section",
            "page",
            "auto"
          ]
        },
        "return_window": {
          "type": "number",
          "description": "Neighbor chunks each side for window (1-3)."
        },
        "token_budget": {
          "type": "number",
          "description": "Evidence token budget (default 6000)."
        },
        "salience": {
          "type": "string",
          "description": "Boost emotional pages (default: auto).",
          "enum": [
            "off",
            "on",
            "strong"
          ]
        },
        "recency": {
          "type": "string",
          "description": "Boost recent pages (default: auto).",
          "enum": [
            "off",
            "on",
            "strong"
          ]
        },
        "fields": {
          "type": "string",
          "description": "lean (remote default) or full.",
          "enum": [
            "lean",
            "full"
          ]
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "query",
    "description": "Ranked hybrid search with multi-query expansion, for concept / synonym / landscape questions: expansion recovers synonym-phrased matches. Still top-K; return_unit returns whole sections or conversations. Lists: list_pages. Exact tokens: `search` is cheaper (no expansion LLM call). Personal questions: get_recent_salience, find_anomalies; raw transcripts: `gbrain transcripts recent` on the brain host. Do NOT assume 'crazy' means impressive (often difficult or emotionally charged). Needs an embedding key, else keyword-only; expansion needs a chat-model key. fields: \"full\" adds diagnostics.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Question or topic (required unless image)."
        },
        "image": {
          "type": "string",
          "description": "Base64 image for image search."
        },
        "image_mime": {
          "type": "string",
          "description": "MIME type of image."
        },
        "limit": {
          "type": "number",
          "description": "Default 10/25/50 by search mode."
        },
        "offset": {
          "type": "number",
          "description": "Rows to skip."
        },
        "types": {
          "type": "array",
          "description": "Page types, e.g. ['person'].",
          "items": {
            "type": "string"
          }
        },
        "snippet_chars": {
          "type": "number",
          "description": "Max chars per chunk_text (0 = full)."
        },
        "return_unit": {
          "type": "string",
          "description": "chunk, window, section, page or auto (default; whole page for conversations).",
          "enum": [
            "chunk",
            "window",
            "section",
            "page",
            "auto"
          ]
        },
        "return_window": {
          "type": "number",
          "description": "Neighbor chunks each side for window (1-3)."
        },
        "token_budget": {
          "type": "number",
          "description": "Token cap on the returned evidence."
        },
        "expand": {
          "type": "boolean",
          "description": "Default true; false skips the expansion LLM call."
        },
        "detail": {
          "type": "string",
          "description": "low (compiled truth only), medium (default) or high (all chunks)."
        },
        "fields": {
          "type": "string",
          "description": "lean (remote default) or full.",
          "enum": [
            "lean",
            "full"
          ]
        },
        "mode": {
          "type": "string",
          "description": "Local callers only."
        },
        "lang": {
          "type": "string",
          "description": "Code language."
        },
        "symbol_kind": {
          "type": "string",
          "description": "Code symbol type."
        },
        "near_symbol": {
          "type": "string",
          "description": "Anchor code symbol."
        },
        "walk_depth": {
          "type": "number",
          "description": "Code walk depth 1-2."
        },
        "salience": {
          "type": "string",
          "description": "Boost emotional pages (default: auto).",
          "enum": [
            "off",
            "on",
            "strong"
          ]
        },
        "recency": {
          "type": "string",
          "description": "Boost recent pages (default: auto).",
          "enum": [
            "off",
            "on",
            "strong"
          ]
        },
        "since": {
          "type": "string",
          "description": "On/after: YYYY-MM-DD or 7d/2w/1y."
        },
        "until": {
          "type": "string",
          "description": "On/before."
        },
        "source_id": {
          "type": "string",
          "description": "One source, or '__all__'."
        },
        "cross_modal": {
          "type": "string",
          "description": "Default auto.",
          "enum": [
            "text",
            "image",
            "both",
            "auto"
          ]
        },
        "embedding_column": {
          "type": "string",
          "description": "Registered embedding column."
        },
        "adaptive_return": {
          "type": "boolean",
          "description": "true when one specific answer is wanted (fewer rows; never returns empty); omit for breadth."
        },
        "autocut": {
          "type": "boolean",
          "description": "Default on (never returns empty); false gives full top-K for breadth. Cuts at the score cliff, unlike adaptive_return."
        },
        "relational": {
          "type": "boolean",
          "description": "Relationship-graph arm (default on)."
        }
      },
      "required": []
    }
  },
