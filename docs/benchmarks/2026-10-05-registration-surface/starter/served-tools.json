[
  {
    "name": "remember",
    "description": "MEMORY VERB (v1): save one fact; provenance required. Set `entity` when the fact has a subject, or entity-scoped recall misses it. Branch on `status` (inserted|duplicate|superseded). write_pending carries a receipt: poll get_write_request.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Write source."
        },
        "expected_revision": {
          "type": "string",
          "description": "Revision read; omit to create."
        },
        "force": {
          "type": "boolean",
          "description": "Ignore the revision."
        },
        "request_id": {
          "type": "string",
          "description": "UUID; retry with it on timeout."
        },
        "fact": {
          "type": "string",
          "description": "One claim."
        },
        "provenance": {
          "type": "string",
          "description": "Where the fact came from (max 500 chars)."
        },
        "ttl": {
          "type": "string",
          "description": "\"30d\", \"12h\" or ISO 8601 time; omit = never."
        },
        "entity": {
          "type": "string",
          "description": "Who or what it is about (name or slug)."
        },
        "infer_entity": {
          "type": "boolean",
          "description": "Default true."
        },
        "kind": {
          "type": "string",
          "description": "Default fact.",
          "enum": [
            "event",
            "preference",
            "commitment",
            "belief",
            "fact"
          ]
        },
        "visibility": {
          "type": "string",
          "description": "world (default) or private (local CLI only).",
          "enum": [
            "world",
            "private"
          ]
        }
      },
      "required": [
        "fact",
        "provenance"
      ]
    }
  },
  {
    "name": "entity",
    "description": "MEMORY VERB (v1): one known person/company/project card, zero LLM. A miss returns found:false with near matches and create_safety, so you do not duplicate a page. Facts: recall.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name, alias or slug (e.g. \"Alice Example\")."
        }
      },
      "required": [
        "name"
      ]
    }
  },
  {
    "name": "synthesize",
    "description": "[EXPENSIVE / SLOW: LLM calls, costs money] MEMORY VERB (v1): answer a broad question across pages with citations. For lookups use recall or entity.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "The question."
        },
        "since": {
          "type": "string",
          "description": "Window start (ISO 8601)."
        },
        "until": {
          "type": "string",
          "description": "Window end (ISO 8601)."
        }
      },
      "required": [
        "question"
      ]
    }
  },
  {
    "name": "forget",
    "description": "MEMORY VERB (v1): expire a remembered fact by its fact_id (never a page slug). Idempotent; the audit trail is kept.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "description": "UUID; retry with it on timeout."
        },
        "id": {
          "type": "string",
          "description": "fact_id from remember or recall."
        },
        "reason": {
          "type": "string",
          "description": "Audit note (default \"forgotten\")."
        }
      },
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "get_page",
    "description": "Read a page by slug (fuzzy optional; renamed slugs redirect). To edit, pass include_content:true and send `content` to put_page, or use edit_page. Timeline rows need include_timeline_entries.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Page slug."
        },
        "fuzzy": {
          "type": "boolean",
          "description": "Fuzzy slug match."
        },
        "include_content": {
          "type": "boolean",
          "description": "Full markdown + revision, for editing."
        },
        "include_deleted": {
          "type": "boolean",
          "description": "Include soft-deleted pages."
        },
        "include_timeline_entries": {
          "type": "boolean",
          "description": "Also return timeline rows."
        },
        "source_id": {
          "type": "string",
          "description": "One source, or '__all__'."
        }
      },
      "required": [
        "slug"
      ]
    }
  },
  {
    "name": "put_page",
    "description": "Replace a complete Markdown page: content REPLACES the whole page. Read get_page include_content:true; pass its revision as expected_revision (omit to create). Keep a request_id UUID; retry with identical arguments. Remote callers: graph links are skipped; a stdio `gbrain serve` sweeps them later, `gbrain serve --http` does not self-sweep. Small changes: edit_page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Write source."
        },
        "expected_revision": {
          "type": "string",
          "description": "Revision read; omit to create."
        },
        "force": {
          "type": "boolean",
          "description": "Ignore the revision."
        },
        "request_id": {
          "type": "string",
          "description": "UUID; retry with it on timeout."
        },
        "slug": {
          "type": "string",
          "description": "Page slug."
        },
        "content": {
          "type": "string",
          "description": "Complete markdown with frontmatter; read get_page include_content:true first."
        },
        "allow_empty": {
          "type": "boolean",
          "description": "Allow emptying a non-empty page."
        },
        "source_kind": {
          "type": "string",
          "description": "Server-stamped remotely."
        },
        "source_uri": {
          "type": "string",
          "description": "Server-stamped remotely."
        },
        "ingested_via": {
          "type": "string",
          "description": "Server-stamped remotely."
        }
      },
      "required": [
        "slug",
        "content"
      ]
    }
  },
  {
    "name": "list_pages",
    "description": "List pages with filters. For 'what's recent / what did I touch this week' use sort=updated_desc. Default 50 rows (remote max 100); a full page may be truncated: continue with updated_after + updated_after_slug from the last row.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Page type."
        },
        "tag": {
          "type": "string",
          "description": "Tag."
        },
        "limit": {
          "type": "number",
          "description": "Max rows (default 50; remote max 100)."
        },
        "offset": {
          "type": "number",
          "description": "Rows to skip."
        },
        "updated_after": {
          "type": "string",
          "description": "Only pages updated after this ISO time."
        },
        "updated_after_slug": {
          "type": "string",
          "description": "Last row's slug (with updated_after)."
        },
        "sort": {
          "type": "string",
          "description": "Default updated_desc.",
          "enum": [
            "updated_desc",
            "updated_asc",
            "created_desc",
            "slug"
          ]
        },
        "include_deleted": {
          "type": "boolean",
          "description": "Include soft-deleted pages."
        },
        "source_id": {
          "type": "string",
          "description": "One source, or '__all__'."
        }
      },
      "required": []
    }
  },
  {
    "name": "capture",
    "description": "Quick note (\"just remember this\"): auto-slugged under inbox/ by date + content hash, so recapturing is idempotent. Use put_page to control slug or type; remember for facts about entities.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Write source."
        },
        "expected_revision": {
          "type": "string",
          "description": "Revision read; omit to create."
        },
        "force": {
          "type": "boolean",
          "description": "Ignore the revision."
        },
        "request_id": {
          "type": "string",
          "description": "UUID; retry with it on timeout."
        },
        "who": {
          "type": "string",
          "description": "Event: comma-separated entity slugs."
        },
        "what": {
          "type": "string",
          "description": "Event."
        },
        "where": {
          "type": "string",
          "description": "Event place."
        },
        "kind": {
          "type": "string",
          "description": "Event kind."
        },
        "depth": {
          "type": "string",
          "description": "Event depth page to link."
        },
        "content": {
          "type": "string",
          "description": "Markdown or text (not a file path)."
        },
        "local_file": {
          "type": "string",
          "description": "Local CLI only."
        },
        "slug": {
          "type": "string",
          "description": "Default inbox/<date>-<hash>."
        },
        "type": {
          "type": "string",
          "description": "Schema-pack page type (default note)."
        }
      },
      "required": [
        "content"
      ]
    }
  },
  {
    "name": "edit_page",
    "description": "Change part of a page: prefer this over put_page for small changes. expected_revision is the revision from get_page include_content:true. Each old_text must match exactly once; edits apply in order, all or none. Stale revision: revision_conflict.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Page slug."
        },
        "expected_revision": {
          "type": "string",
          "description": "revision from get_page include_content:true."
        },
        "edits": {
          "type": "array",
          "description": "1 to 50 {old_text, new_text} replacements.",
          "items": {
            "type": "object",
            "properties": {
              "old_text": {
                "type": "string",
                "description": "Exact text to replace (must occur once)."
              },
              "new_text": {
                "type": "string",
                "description": "Replacement; empty deletes."
              }
            },
            "required": [
              "old_text",
              "new_text"
            ],
            "additionalProperties": false
          }
        },
        "source_id": {
          "type": "string",
          "description": "Write source."
        },
        "request_id": {
          "type": "string",
          "description": "UUID; retry with it on timeout."
        }
      },
      "required": [
        "slug",
        "expected_revision",
        "edits"
      ]
    }
  },
  {
    "name": "get_write_request",
