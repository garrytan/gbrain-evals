+const EXP_HEADING = /^ {0,3}(#{1,6})[ \t]+(.+?)[ \t#]*$/;
+const EXP_FENCE = /^ {0,3}(```|~~~)/;
+
+/**
+ * Experiment (structure-aware chunks, not for merge): the ATX heading ancestry of the section holding most of each
+ * chunk's bytes, joined with ' › ', or '' when most of the chunk sits before the first heading. Headings inside code
+ * fences are ignored. Spans are UTF-8 byte offsets into `projected`.
+ */
+export function experimentHeadingPaths(projected: string, chunks: ReadonlyArray<{ byte_start?: number; byte_end?: number }>): string[] {
+  const heads: Array<{ at: number; level: number; text: string }> = [];
+  let at = 0;
+  let inFence = false;
+  for (const line of projected.split('\n')) {
+    if (EXP_FENCE.test(line)) inFence = !inFence;
+    else if (!inFence) {
+      const m = EXP_HEADING.exec(line);
+      if (m) heads.push({ at, level: m[1].length, text: m[2].replace(/\s+/g, ' ').trim() });
+    }
+    at += Buffer.byteLength(line, 'utf8') + 1;
+  }
+  if (heads.length === 0) return chunks.map(() => '');
+  const paths: string[] = [];
+  const stack: Array<{ level: number; text: string }> = [];
+  for (const h of heads) {
+    while (stack.length > 0 && stack[stack.length - 1].level >= h.level) stack.pop();
+    stack.push(h);
+    paths.push(stack.map(s => s.text).join(' › '));
+  }
+  const regions = [{ start: 0, end: heads[0].at, i: -1 }, ...heads.map((h, i) => ({ start: h.at, end: i + 1 < heads.length ? heads[i + 1].at : at, i }))];
+  return chunks.map(c => {
+    if (c.byte_start === undefined || c.byte_end === undefined) return '';
+    let best = -1;
+    let bestLen = 0;
+    for (const r of regions) {
+      const len = Math.min(c.byte_end, r.end) - Math.max(c.byte_start, r.start);
+      if (len > bestLen) { bestLen = len; best = r.i; }
+    }
+    return best >= 0 ? paths[best] : '';
+  });
+}
