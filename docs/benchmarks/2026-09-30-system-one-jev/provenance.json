  "measured": {
    "date": "2026-09-30",
    "window_utc": "2026-09-30T21:23Z to 2026-09-30T23:45Z (ledger timestamps)",
    "branch": "feat/system-one-v1-evals",
    "code": "gbrain v0.60.17.0 plus the System One branch: the eval flags landed in afeab73cc37464f46a82b3bb8b35be720036b9a1 and the receipts were committed in 57661631f9cb3b0fb11c6b36417387d8b7e8f595. The receipts do not record a per-run commit; every pair ran within that window, and gbrain's protocol states runs never mixed commits within a pair.",
    "eval_flags_commit": "afeab73cc37464f46a82b3bb8b35be720036b9a1",
    "receipts_commit": "57661631f9cb3b0fb11c6b36417387d8b7e8f595",
