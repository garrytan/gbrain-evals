# SHIM_CONFIG=entity-h2h: the server defaults of Hindsight 1.2.1 with the LLM set to gpt-6.2-sol (entity-resolution
# head-to-head). The reranker is the 1.2.1 default, hindsight-ai/hs-rerank-1 (vectorize-io/hindsight#6263); the 1.2.1
# image bundles only it and the embedder below, so cross-encoder/ms-marco-MiniLM-L-6-v2 cannot load with HF_HUB_OFFLINE=1.
HINDSIGHT_API_LLM_MODEL=gpt-6.2-sol
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=hindsight-ai/hs-rerank-1
